---
title: Tire - Diagrama de clases de la capa de aplicacion (tire-backend)
---
%% Columnas: puertos de entrada (casos de uso) -> servicios -> puertos de salida
%% Los Comando* son records de application.port.in; las entidades estan en diagrama_clases.mmd
classDiagram
    direction LR

    %% ============ Puertos de entrada ============
    class AutenticacionUseCase {
        <<interface>>
        +registrarUsuario(ComandoRegistro) Usuario
        +iniciarSesion(email, password) RespuestaToken
        +cambiarContrasena(usuarioId, actual, nueva) void
        +solicitarRecuperacion(email) void
    }
    class GestionConductoresUseCase {
        <<interface>>
        +crear(ComandoCrearConductor) Conductor
        +listarTodos() List~Conductor~
        +obtenerPorId(id) Conductor
        +actualizar(id, ComandoActualizarConductor) Conductor
        +desactivar(id) Conductor
    }
    class GestionViajesUseCase {
        <<interface>>
        +iniciarViaje(ComandoIniciarViaje) Viaje
        +listarViajes() List~Viaje~
        +obtenerViajePorId(id) Viaje
        +finalizarViaje(id) Viaje
        +cancelarViaje(id) void
        +registrarTelemetria(id, ComandoTelemetria) Viaje
        +registrarEventoFatiga(id, ComandoEventoFatiga) Viaje
        +confirmarAlerta(id) Viaje
    }
    class GestionAlertasUseCase {
        <<interface>>
        +listarViajesActivos() List~Viaje~
        +listarAlertasAbiertas() List~AlertaCritica~
        +listarIncidentesAtendidos(inicio, fin) List~AlertaCritica~
        +atenderAlerta(id, notas) AlertaCritica
    }

    %% ============ Servicios (@Service) ============
    class AutenticacionService {
        <<Service>>
        email unico, password hasheada con BCrypt
        login: usuario activo, emite JWT
        nueva password de 8 caracteres o mas
    }
    class GestionConductoresService {
        <<Service>>
        documento y correo unicos
        desactivar = soft delete
    }
    class GestionViajesService {
        <<Service>>
        un solo viaje EN_CURSO por conductor: 409
        consulta clima en inicio, telemetria y eventos
        si el viaje queda CRITICO abre AlertaCritica
    }
    class GestionAlertasService {
        <<Service>>
        atender delega en AlertaCritica.atender()
    }

    %% ============ Puertos de salida ============
    class UsuarioRepositoryPort {
        <<interface>>
        +guardar(Usuario) Usuario
        +buscarPorEmail(email) Optional~Usuario~
        +buscarPorId(id) Optional~Usuario~
        +existePorEmail(email) boolean
    }
    class ProveedorAutenticacionPort {
        <<interface>>
        +hashearContrasena(plano) String
        +verificarContrasena(plano, hash) boolean
        +emitirToken(Usuario) String
        +validarToken(token) ClaimsAutenticacion
    }
    class ConductorRepositoryPort {
        <<interface>>
        +guardar(Conductor) Conductor
        +buscarPorId(id) Optional~Conductor~
        +listarTodos() List~Conductor~
        +existePorDocumento(documento) boolean
        +existePorCorreo(correo) boolean
    }
    class AlertaCriticaRepositoryPort {
        <<interface>>
        +guardar(AlertaCritica) AlertaCritica
        +buscarPorId(id) Optional~AlertaCritica~
        +listarPorAtendida(boolean) List~AlertaCritica~
    }
    class ViajeRepositoryPort {
        <<interface>>
        +guardar(Viaje) Viaje
        +buscarPorId(id) Optional~Viaje~
        +listarTodos() List~Viaje~
        +listarPorEstado(EstadoViaje) List~Viaje~
        +existeViajeEnCursoParaConductor(id) boolean
    }
    class ConsultorClimaPort {
        <<interface>>
        +consultarClimaActual(lat, lon) CondicionClimatica
    }

    %% ---------- Implementacion de casos de uso ----------
    AutenticacionUseCase <|.. AutenticacionService
    GestionConductoresUseCase <|.. GestionConductoresService
    GestionViajesUseCase <|.. GestionViajesService
    GestionAlertasUseCase <|.. GestionAlertasService

    %% ---------- Dependencias inyectadas por constructor ----------
    AutenticacionService --> UsuarioRepositoryPort
    AutenticacionService --> ProveedorAutenticacionPort
    GestionConductoresService --> ConductorRepositoryPort
    GestionAlertasService --> ViajeRepositoryPort
    GestionAlertasService --> AlertaCriticaRepositoryPort
    GestionViajesService --> ViajeRepositoryPort
    GestionViajesService --> AlertaCriticaRepositoryPort
    GestionViajesService --> ConsultorClimaPort
